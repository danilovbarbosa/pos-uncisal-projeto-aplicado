# Variáveis de ambiente do stack Docker (web + nginx).
# NÃO versionar (já coberto pelo .gitignore via *.docker? — veja abaixo).

DJANGO_SECRET_KEY=change_key

# Produção: DEBUG desligado.
DJANGO_DEBUG=false

# Hosts servidos pelo Nginx.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origem confiável para CSRF (HTTPS via Nginx).
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1

# O Nginx faz o redirect 80->443, então o Django NÃO deve redirecionar
# (evita loop). Mas os cookies devem ser marcados como seguros e o Django
# reconhece HTTPS pelo header X-Forwarded-Proto (SECURE_PROXY_SSL_HEADER).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Usuário de demonstração criado automaticamente no primeiro boot.
CREATE_DEMO_USER=true
DEMO_USERNAME=aluno
DEMO_EMAIL=aluno@example.com
DEMO_PASSWORD=SenhaForte2025!
